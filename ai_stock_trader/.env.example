# ---------------------------------------------------------------
# 이 파일을 .env 로 복사한 뒤 값을 채워 넣으세요.
# .env 는 절대 공유하거나 깃에 올리지 마세요. 계좌가 털립니다.
# ---------------------------------------------------------------

# Google Gemini (AI 리뷰 / 파라미터 제안용. 없어도 매매는 동작합니다)
GEMINI_API_KEY=

# 한국투자증권 모의투자 (https://apiportal.koreainvestment.com 에서 발급)
KIS_MOCK_APP_KEY=
KIS_MOCK_APP_SECRET=
KIS_MOCK_CANO=            # 계좌번호 앞 8자리
KIS_MOCK_ACNT_PRDT_CD=01  # 계좌번호 뒤 2자리

# 한국투자증권 실전투자 (시세 조회에도 쓰입니다. 주문은 REAL 모드에서만)
KIS_REAL_APP_KEY=
KIS_REAL_APP_SECRET=
KIS_REAL_CANO=
KIS_REAL_ACNT_PRDT_CD=01

# 텔레그램 알림 (선택). @BotFather 로 봇 생성 후 토큰,
# 봇에게 메시지 한 번 보내고 api.telegram.org/bot<토큰>/getUpdates 에서 chat id 확인
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
